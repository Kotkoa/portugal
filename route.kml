    <Placemark>
      <name>🏠 Старт / Финиш — Дом, Pego</name>
      <description><![CDATA[Carrer de Sant Pere 67, 03780 Pego. Выезд день 1 в 8:00 (или 10:00).]]></description>
      <styleUrl>#home</styleUrl>
      <Point><coordinates>-0.116693,38.837457,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🔶 Узловая точка — A-33, Jumilla</name>
      <description><![CDATA[A-33, 30529 Jumilla (Murcia). Развилка маршрута туда. ~160 км от дома.]]></description>
      <styleUrl>#node</styleUrl>
      <Point><coordinates>-1.150924,38.532482,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>💜 ЦЕЛЬ — Лавандовое поле, Zaén</name>
      <description><![CDATA[Ctra. de Zaén de Abajo a Zaén de Arriba, Moratalla. Главная цель — фотосессия в лаванде. Сезон цветения: конец июня — июль.]]></description>
      <styleUrl>#goal</styleUrl>
      <Point><coordinates>-2.057258,38.226320,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🛏 Ночёвка — Moratalla (район)</name>
      <description><![CDATA[Поиск отеля/casa rural в Moratalla или у лавандовых полей. Подтвердить бронь заранее (горный район, мало вариантов).]]></description>
      <styleUrl>#hotel</styleUrl>
      <Point><coordinates>-1.890312,38.184638,0</coordinates></Point>
    </Placemark>

